[Unit]
Description=Apply ASUS B9406CAA PixArt haptic touchpad settings
After=systemd-udevd.service
Wants=systemd-udevd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/asus-b9406-hapticctl --wait 12
RemainAfterExit=yes
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
